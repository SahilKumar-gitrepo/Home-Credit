# ============================================================
# Agentic AI Credit Underwriting System
# Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Database
# SQLite (default — no setup needed):
DATABASE_URL=sqlite:///./data/audit.db
# PostgreSQL (for production/Docker):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/credit_underwriting

# LLM Provider
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# CORS — comma-separated origins for the frontend
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Debug
DEBUG=false

# Model versions (informational)
MODEL_VERSION=pd_xgboost_v1
POLICY_VERSION=research_policy_v1

# Research policy thresholds (NOT official banking policy)
PD_APPROVE_MAX=0.40
PD_DECLINE_MIN=0.70
PD_RISK_TIER_LOW_MAX=0.20
PD_RISK_TIER_MODERATE_MAX=0.40
PD_RISK_TIER_HIGH_MAX=0.60
MIN_INCOME=50000.0
MAX_CREDIT_TO_INCOME=10.0
MAX_CC_UTILIZATION=1.50
